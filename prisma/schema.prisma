// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Multi-tenant: Tenants table for organization isolation
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free, pro, enterprise
  settings  Json?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  contacts  Contact[]
  companies Company[]
  feedback  Feedback[]
  
  @@index([slug])
  @@index([plan])
}

// Users table with tenant association
model User {
  id             String   @id @default(uuid())
  tenantId       String
  email          String   @unique
  passwordHash   String
  name           String
  emailVerified  Boolean  @default(false)
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  interactions   Interaction[]
  tasks          Task[]
  deals          Deal[]
  feedback       Feedback[]
  
  @@index([tenantId])
  @@index([email])
}

// Companies table
model Company {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  industry    String?
  size        String?  // startup, small, medium, large, enterprise
  location    String?
  website     String?
  foundedYear Int?
  revenue     Float?
  employeeCount Int?
  description String?
  tags        Json?    // Changed from String[] for MySQL compatibility
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([name])
  @@index([industry])
}

// Contacts table
model Contact {
  id              String   @id @default(uuid())
  tenantId        String
  companyName     String?  // Manual company name entry
  name            String
  phone           String?
  email           String?
  location        String?
  industry        String?
  source          String?  // linkedin, whatsapp, other
  stage           String   @default("new") // new, contacted, meeting, negotiating, collaborating, archived
  tags            Json?    // Changed from String[] for MySQL compatibility
  lastContactDate DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  interactions    Interaction[]
  tasks           Task[]
  deals           Deal[]
  
  @@index([tenantId])
  @@index([companyName])
  @@index([stage])
  @@index([source])
  @@index([name])
}

// Appointments table
model Appointment {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String?
  userId      String?
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  type        String?  // call, meeting, video, email, task, other
  recurrence  Json?    // { frequency, interval, endDate, occurrences }
  reminder    Json?    // { timing, customMinutes }
  status      String   @default("scheduled") // scheduled, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  interactions Interaction[]
  
  @@index([tenantId])
  @@index([contactId])
  @@index([startTime])
  @@index([status])
}

// Interactions table
model Interaction {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String?
  userId      String?
  appointmentId String?
  type        String  // call, email, message, meeting, other
  direction   String  // inbound, outbound
  subject     String?
  content     String?
  timestamp   DateTime
  duration    Int?
  outcome     String? // follow-up_required, awaiting_response, completed, no_response, not_interested, custom
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  
  @@index([tenantId])
  @@index([contactId])
  @@index([type])
  @@index([timestamp])
  @@index([outcome])
}

// Tasks table
model Task {
  id          String   @id @default(uuid())
  tenantId    String
  contactId   String?
  userId      String?
  title       String
  description String?
  status      String   @default("todo") // todo, in_progress, review, done
  priority    String   @default("medium") // low, medium, high
  dueDate     DateTime?
  reminder    Json?    // { timing, customMinutes }
  estimatedTime Int?
  actualTime  Int?
  category    String?  // follow-up, research, meeting_prep, administrative, development, custom
  tags        Json?    // Changed from String[] for MySQL compatibility
  linkedItems Json?    // { appointments: [], interactions: [], deals: [] }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([tenantId])
  @@index([contactId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([category])
}

// Deals table
model Deal {
  id                String   @id @default(uuid())
  tenantId          String
  contactId         String?
  userId            String?
  company           String?  // Manual company name entry
  name              String
  value             Float?
  currency          String   @default("USD")
  probability       Int      @default(50)
  expectedCloseDate DateTime?
  stage             String   @default("prospecting") // prospecting, qualification, proposal, negotiation, closing, won, lost
  source            String?
  competitors       Json?    // Changed from String[] for MySQL compatibility
  nextSteps         Json?    // Changed from String[] for MySQL compatibility
  tags              Json?    // Changed from String[] for MySQL compatibility
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contact           Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([tenantId])
  @@index([contactId])
  @@index([company])
  @@index([stage])
  @@index([probability])
  @@index([expectedCloseDate])
}

// Email verification tokens
model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// Admin accounts for platform management
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  email        String   @unique
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications Notification[]
  
  @@index([username])
  @@index([email])
}

// Admin notifications
model Notification {
  id        String   @id @default(uuid())
  adminId   String
  type      String   // feedback, user, system
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  @@index([adminId])
  @@index([read])
}

// User feedback system
model Feedback {
  id           String   @id @default(uuid())
  userId       String
  tenantId     String
  subject      String   // category from dropdown or custom
  category     String   // subcategory based on subject
  content      String
  rating       Int      // 1-5 stars
  priority     String   @default("medium") // high, medium, low
  status       String   @default("open") // open, in_progress, resolved, closed, archived
  adminReply   String?
  replyDate    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([rating])
}